---
import ToolLayout from '../layouts/ToolLayout.astro';
import JsonToCsv from '../components/JsonToCsv';
import RelatedTools from '../components/RelatedTools.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import { getTool, getRelatedTools } from '../data/tools';

const tool = getTool('json-to-csv')!;
const related = getRelatedTools(tool);

const faqItems = [
  { q: 'What JSON shape does this expect?', a: 'An array of flat-ish objects, like [{"name":"Alice","age":30}]. Each object becomes a row; the union of all keys across every object becomes the column headers.' },
  { q: 'What happens to missing fields?', a: 'If an object is missing a key that other objects have, that cell is left blank in the output row — the column still exists.' },
  { q: 'What happens to nested objects or arrays?', a: 'A nested value is serialized as a compact JSON string inside its cell, so no data is lost, though it won\'t be split into further columns.' },
  { q: 'Can I open the output in Excel or Google Sheets?', a: 'Yes — the output is standard RFC 4180 CSV. Download it as a .csv file and open it directly in any spreadsheet application.' },
  { q: 'Does this tool upload my data?', a: 'No. The conversion runs entirely in your browser; nothing is sent to a server.' },
];
---
<ToolLayout tool={tool}>
  <JsonToCsv client:load />

  <AdSlot placement="below-tool" />

  <div class="mx-auto w-full max-w-[860px] space-y-8 px-4 py-10">
    <RelatedTools tools={related} />

    <details class="rounded-lg border" style="border-color:var(--border);background:var(--bg-subtle)">
      <summary class="cursor-pointer px-4 py-3 text-sm font-semibold" style="color:var(--fg)">Documentation</summary>
      <div class="space-y-5 px-4 pb-5 text-sm leading-relaxed" style="color:var(--fg-muted)">
        <section>
          <h2 class="mb-1.5 text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">What is JSON to CSV?</h2>
          <p>It converts a JSON array of objects into a spreadsheet-ready CSV file — the most common shape for exporting API responses into Excel or a database import tool.</p>
        </section>
        <section>
          <h2 class="mb-1.5 text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Example</h2>
          <p>Input: <code class="font-mono text-xs" style="color:var(--accent)">{'[{"name":"Alice","age":30},{"name":"Bob","age":25}]'}</code></p>
          <pre class="overflow-x-auto rounded border p-3 font-mono text-xs" style="border-color:var(--border);background:var(--bg)">{`name,age
Alice,30
Bob,25`}</pre>
        </section>
        <section>
          <h2 class="mb-1.5 text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Common errors</h2>
          <p>The input must be a JSON array at the top level — a single object or a deeply nested structure without a flat array of records won't convert cleanly.</p>
        </section>
      </div>
    </details>

    <FAQ items={faqItems} />
  </div>
</ToolLayout>
