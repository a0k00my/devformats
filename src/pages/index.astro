---
import Layout from '../layouts/Layout.astro';
import SearchTrigger from '../components/SearchTrigger.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getToolsOrThrow, CATEGORY_META, type Category } from '../data/tools';

const popularSlugs = [
  'json-formatter', 'json-validator', 'json-parser', 'json-viewer',
  'yaml-formatter', 'xml-formatter', 'jwt-decoder', 'base64',
  'csv-to-json', 'json-to-yaml',
];
const popularTools = getToolsOrThrow(popularSlugs);
const categories = Object.keys(CATEGORY_META) as Category[];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://devformats.com/#website',
      name: 'DevFormats',
      url: 'https://devformats.com',
      description: 'Fast, private developer tools for formatting, validating, converting and generating structured data.',
    },
    {
      '@type': 'WebPage',
      '@id': 'https://devformats.com/#webpage',
      url: 'https://devformats.com',
      name: 'DevFormats — Fast Developer Tools for Structured Data',
      isPartOf: { '@id': 'https://devformats.com/#website' },
    },
  ],
};
---
<Layout
  title="DevFormats — Fast Developer Tools for Structured Data"
  description="Format, validate, convert and generate JSON, YAML, XML, JWT, CSV and more — all processed locally in your browser. Free, private, no signup."
  canonical="https://devformats.com"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b px-4 py-24 text-center sm:py-32" style="border-color:var(--border)">
    <div
      class="hero-glow pointer-events-none absolute left-1/2 top-0 h-[520px] w-[520px] -translate-x-1/2 -translate-y-1/3 rounded-full blur-3xl"
      style="background:var(--accent);opacity:0.09"
      aria-hidden="true"
    ></div>
    <div
      class="hero-glow pointer-events-none absolute right-0 bottom-0 h-[380px] w-[380px] translate-x-1/3 translate-y-1/3 rounded-full blur-3xl"
      style="background:#a78bfa;opacity:0.08;animation-delay:2s"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-2xl animate-[fadein_0.4s_ease-out]">
      <div class="mb-7 flex items-center justify-center gap-2.5">
        <img src="/favicon-96x96.png" alt="" class="h-10 w-10 rounded-lg" />
        <span class="text-xl font-semibold tracking-tight" style="color:var(--fg)">Dev<span style="color:var(--accent)">Formats</span></span>
      </div>
      <span class="hero-badge mb-5">✨ 50+ free developer tools, zero signup</span>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl" style="color:var(--fg)">
        Fast Developer Tools<br />for <span class="gradient-text">Structured Data</span>
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed sm:text-lg" style="color:var(--fg-muted)">
        Format, validate, convert and generate JSON, YAML, XML, JWT, CSV and more — all processed locally in your browser.
      </p>
      <div class="mx-auto mt-9 max-w-xl">
        <SearchTrigger variant="hero" />
      </div>
      <p class="mt-4 text-xs" style="color:var(--fg-subtle)">Turn off your wifi — the tools still work. Nothing is ever uploaded.</p>

      <div class="reveal-stagger mx-auto mt-14 grid max-w-lg grid-cols-3 gap-6">
        <div class="stat-item">
          <div class="stat-num">50+</div>
          <div class="mt-1 text-xs" style="color:var(--fg-subtle)">Tools</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">0</div>
          <div class="mt-1 text-xs" style="color:var(--fg-subtle)">Uploads</div>
        </div>
        <div class="stat-item">
          <div class="stat-num">100%</div>
          <div class="mt-1 text-xs" style="color:var(--fg-subtle)">Free</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Tools -->
  <section class="mx-auto max-w-[1300px] px-4 py-16">
    <h2 class="reveal mb-6 font-mono text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Popular Tools</h2>
    <div class="reveal-stagger grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {popularTools.map(tool => <ToolCard tool={tool} />)}
    </div>
  </section>

  <!-- Browse by Category -->
  <section class="border-t px-4 py-16" style="border-color:var(--border);background:var(--bg-subtle)">
    <div class="mx-auto max-w-[1300px]">
      <h2 class="reveal mb-6 font-mono text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Browse by Category</h2>
      <div class="reveal-stagger grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map(c => <CategoryCard category={c} />)}
      </div>
    </div>
  </section>

  <!-- Why DevFormats -->
  <section class="border-t px-4 py-16" style="border-color:var(--border)">
    <div class="mx-auto max-w-[1300px]">
      <h2 class="reveal mb-6 font-mono text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Why DevFormats</h2>
      <div class="reveal-stagger grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="df-card card-teal group rounded-xl border p-6 transition-all duration-200 ease-out hover:-translate-y-1"
          style="border-color:var(--border)"
          onmouseover="this.style.boxShadow='var(--shadow-md)'"
          onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='var(--shadow-sm)'">
          <div class="df-card-icon mb-4 flex h-12 w-12 items-center justify-center rounded-lg text-xl transition-transform duration-200 ease-out group-hover:scale-110">⚡</div>
          <div class="mb-1.5 text-base font-semibold" style="color:var(--fg)">Fast</div>
          <p class="text-sm leading-relaxed" style="color:var(--fg-muted)">Runs instantly, no upload, no queue.</p>
        </div>
        <div class="df-card card-blue group rounded-xl border p-6 transition-all duration-200 ease-out hover:-translate-y-1"
          style="border-color:var(--border)"
          onmouseover="this.style.boxShadow='var(--shadow-md)'"
          onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='var(--shadow-sm)'">
          <div class="df-card-icon mb-4 flex h-12 w-12 items-center justify-center rounded-lg text-xl transition-transform duration-200 ease-out group-hover:scale-110">🔒</div>
          <div class="mb-1.5 text-base font-semibold" style="color:var(--fg)">Privacy First</div>
          <p class="text-sm leading-relaxed" style="color:var(--fg-muted)">Everything stays in your browser. Nothing is uploaded, ever.</p>
        </div>
        <div class="df-card card-purple group rounded-xl border p-6 transition-all duration-200 ease-out hover:-translate-y-1"
          style="border-color:var(--border)"
          onmouseover="this.style.boxShadow='var(--shadow-md)'"
          onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='var(--shadow-sm)'">
          <div class="df-card-icon mb-4 flex h-12 w-12 items-center justify-center rounded-lg text-xl transition-transform duration-200 ease-out group-hover:scale-110">🌍</div>
          <div class="mb-1.5 text-base font-semibold" style="color:var(--fg)">Free</div>
          <p class="text-sm leading-relaxed" style="color:var(--fg-muted)">Unlimited usage. No signup, no limits, no watermarks.</p>
        </div>
        <div class="df-card card-amber group rounded-xl border p-6 transition-all duration-200 ease-out hover:-translate-y-1"
          style="border-color:var(--border)"
          onmouseover="this.style.boxShadow='var(--shadow-md)'"
          onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='var(--shadow-sm)'">
          <div class="df-card-icon mb-4 flex h-12 w-12 items-center justify-center rounded-lg text-xl transition-transform duration-200 ease-out group-hover:scale-110">💻</div>
          <div class="mb-1.5 text-base font-semibold" style="color:var(--fg)">Built for Developers</div>
          <p class="text-sm leading-relaxed" style="color:var(--fg-muted)">Keyboard shortcuts, dark mode, responsive on any device.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
</style>
