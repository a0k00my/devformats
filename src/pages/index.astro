    {
      "@type": "WebPage",
      "@id": "https://jsonformatteronline.in/#webpage",
      "url": "https://jsonformatteronline.in",
      "name": "JSON Formatter Online — Free Pretty JSON Formatter & Validator Tool",
      "description": "The best free online JSON formatter. Beautify, validate, and minify JSON instantly. Pretty JSON formatter with syntax highlighting — all in your browser.",
      "isPartOf": { "@id": "https://jsonformatteronline.in/#app" },
