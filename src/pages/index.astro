      "@id": "https://jsonformatteronline.in/#app",
      "name": "JSON Formatter Online",
      "alternateName": ["Free JSON Formatter", "Online JSON Formatter", "Pretty JSON Formatter", "JSON Formatter Tool"],
      "url": "https://jsonformatteronline.in",
      "description": "The best free online JSON formatter and validator. Format, beautify, validate, and minify JSON instantly in your browser. No data sent to servers — 100% private.",
      "applicationCategory": "DeveloperApplication",
      "applicationSubCategory": "Developer Tools",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "featureList": [
        "Pretty JSON Formatter",
