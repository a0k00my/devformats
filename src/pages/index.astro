        },
        {
          "@type": "Question",
          "name": "What is the full form of JSON?",
          "acceptedAnswer": { "@type": "Answer", "text": "JSON stands for JavaScript Object Notation. Despite the name, JSON is completely language-independent — it is supported natively in Python, Java, PHP, Ruby, Go, Rust, and virtually every other programming language, making it the universal standard for data exchange on the web." }
