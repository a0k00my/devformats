---
import Layout from '../layouts/Layout.astro';
import SearchTrigger from '../components/SearchTrigger.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getToolsOrThrow, CATEGORY_META, type Category } from '../data/tools';

const popularSlugs = [
  'json-formatter', 'json-validator', 'json-parser', 'json-viewer',
  'yaml-formatter', 'xml-formatter', 'jwt-decoder', 'base64',
  'csv-to-json', 'json-to-yaml',
];
const popularTools = getToolsOrThrow(popularSlugs);
const categories = Object.keys(CATEGORY_META) as Category[];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://devformats.com/#website',
      name: 'DevFormats',
      url: 'https://devformats.com',
      description: 'Fast, private developer tools for formatting, validating, converting and generating structured data.',
    },
    {
      '@type': 'WebPage',
      '@id': 'https://devformats.com/#webpage',
      url: 'https://devformats.com',
      name: 'DevFormats — Fast Developer Tools for Structured Data',
      isPartOf: { '@id': 'https://devformats.com/#website' },
    },
  ],
};
---
<Layout
  title="DevFormats — Fast Developer Tools for Structured Data"
  description="Format, validate, convert and generate JSON, YAML, XML, JWT, CSV and more — all processed locally in your browser. Free, private, no signup."
  canonical="https://devformats.com"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b px-4 py-20 text-center sm:py-28" style="border-color:var(--border)">
    <div
      class="hero-glow pointer-events-none absolute left-1/2 top-0 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/3 rounded-full blur-3xl"
      style="background:var(--accent);opacity:0.14"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto max-w-2xl animate-[fadein_0.4s_ease-out]">
      <div class="mb-6 flex items-center justify-center gap-2">
        <img src="/favicon-96x96.png" alt="" class="h-9 w-9 rounded-lg" />
        <span class="text-lg font-semibold tracking-tight" style="color:var(--fg)">Dev<span style="color:var(--accent)">Formats</span></span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color:var(--fg)">Fast Developer Tools for Structured Data</h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed" style="color:var(--fg-muted)">
        Format, validate, convert and generate JSON, YAML, XML, JWT, CSV and more — all processed locally in your browser.
      </p>
      <div class="mx-auto mt-8 max-w-xl">
        <SearchTrigger variant="hero" />
      </div>
      <p class="mt-4 text-xs" style="color:var(--fg-subtle)">Turn off your wifi — the tools still work. Nothing is ever uploaded.</p>
    </div>
  </section>

  <!-- Popular Tools -->
  <section class="mx-auto max-w-[1200px] px-4 py-14">
    <h2 class="reveal mb-5 font-mono text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Popular Tools</h2>
    <div class="reveal-stagger grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {popularTools.map(tool => <ToolCard tool={tool} />)}
    </div>
  </section>

  <!-- Browse by Category -->
  <section class="border-t px-4 py-14" style="border-color:var(--border);background:var(--bg-subtle)">
    <div class="mx-auto max-w-[1200px]">
      <h2 class="reveal mb-5 font-mono text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Browse by Category</h2>
      <div class="reveal-stagger grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map(c => <CategoryCard category={c} />)}
      </div>
    </div>
  </section>

  <!-- Why DevFormats -->
  <section class="border-t px-4 py-14" style="border-color:var(--border)">
    <div class="mx-auto max-w-[1200px]">
      <h2 class="reveal mb-5 font-mono text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Why DevFormats</h2>
      <div class="reveal-stagger grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg border p-4 transition-all duration-200 ease-out hover:-translate-y-0.5" style="border-color:var(--border);background:var(--bg)">
          <div class="mb-2 text-xl">⚡</div>
          <div class="mb-1 text-sm font-semibold" style="color:var(--fg)">Fast</div>
          <p class="text-xs leading-relaxed" style="color:var(--fg-muted)">Runs instantly, no upload, no queue.</p>
        </div>
        <div class="rounded-lg border p-4 transition-all duration-200 ease-out hover:-translate-y-0.5" style="border-color:var(--border);background:var(--bg)">
          <div class="mb-2 text-xl">🔒</div>
          <div class="mb-1 text-sm font-semibold" style="color:var(--fg)">Privacy First</div>
          <p class="text-xs leading-relaxed" style="color:var(--fg-muted)">Everything stays in your browser. Nothing is uploaded, ever.</p>
        </div>
        <div class="rounded-lg border p-4 transition-all duration-200 ease-out hover:-translate-y-0.5" style="border-color:var(--border);background:var(--bg)">
          <div class="mb-2 text-xl">🌍</div>
          <div class="mb-1 text-sm font-semibold" style="color:var(--fg)">Free</div>
          <p class="text-xs leading-relaxed" style="color:var(--fg-muted)">Unlimited usage. No signup, no limits, no watermarks.</p>
        </div>
        <div class="rounded-lg border p-4 transition-all duration-200 ease-out hover:-translate-y-0.5" style="border-color:var(--border);background:var(--bg)">
          <div class="mb-2 text-xl">💻</div>
          <div class="mb-1 text-sm font-semibold" style="color:var(--fg)">Built for Developers</div>
          <p class="text-xs leading-relaxed" style="color:var(--fg-muted)">Keyboard shortcuts, dark mode, responsive on any device.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
</style>
