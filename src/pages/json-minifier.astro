---
import ToolLayout from '../layouts/ToolLayout.astro';
import JsonMinifier from '../components/JsonMinifier';
import RelatedTools from '../components/RelatedTools.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import { getTool, getRelatedTools } from '../data/tools';

const tool = getTool('json-minifier')!;
const related = getRelatedTools(tool);

const faqItems = [
  { q: 'What does JSON minification do?', a: 'It strips every non-essential whitespace character — spaces, tabs, newlines — leaving the smallest valid JSON string that parses to the exact same data.' },
  { q: 'Does minifying change the data?', a: 'No. JSON.parse(minified) and JSON.parse(original) produce identical objects. Only the textual representation shrinks.' },
  { q: 'Why minify before sending JSON over a network?', a: 'Smaller payloads mean less bandwidth and slightly faster transfer, which adds up at scale for high-traffic APIs.' },
  { q: 'How much smaller does minified JSON get?', a: 'It depends on indentation depth — deeply nested, heavily indented JSON can shrink 30-50%. The tool shows exact byte counts and percentage saved.' },
  { q: 'Can I reformat minified JSON later?', a: 'Yes — paste the minified output into the JSON Formatter to pretty-print it again at any time.' },
  { q: 'Is this safe for large files?', a: 'Yes, minification uses native JSON.parse/stringify, so it scales to tens of megabytes in milliseconds on any modern device.' },
];
---
<ToolLayout tool={tool}>
  <JsonMinifier client:load />

  <AdSlot placement="below-tool" />

  <div class="mx-auto w-full max-w-[860px] space-y-8 px-4 py-10">
    <RelatedTools tools={related} />

    <details class="rounded-lg border" style="border-color:var(--border);background:var(--bg-subtle)">
      <summary class="cursor-pointer px-4 py-3 text-sm font-semibold" style="color:var(--fg)">Documentation</summary>
      <div class="space-y-5 px-4 pb-5 text-sm leading-relaxed" style="color:var(--fg-muted)">
        <section>
          <h2 class="mb-1.5 text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">What is JSON Minifier?</h2>
          <p>A tool that removes all non-essential whitespace from JSON, producing the smallest valid representation of the same data — useful right before sending a payload over the network or into storage.</p>
        </section>
        <section>
          <h2 class="mb-1.5 text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">How it works</h2>
          <p>The input is parsed with <code class="font-mono text-xs" style="color:var(--accent)">JSON.parse()</code> then re-serialized with <code class="font-mono text-xs" style="color:var(--accent)">JSON.stringify()</code> and no indentation argument, which naturally omits all extra whitespace.</p>
        </section>
        <section>
          <h2 class="mb-1.5 text-xs font-semibold uppercase tracking-wider" style="color:var(--accent)">Best practices</h2>
          <p>Keep production payloads minified; only format when a human needs to read the file. Version-controlled fixtures are the exception — keep those formatted for readable diffs.</p>
        </section>
      </div>
    </details>

    <FAQ items={faqItems} />
  </div>
</ToolLayout>
