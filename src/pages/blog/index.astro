---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---
<Layout
  title="Blog | DevFormats"
  description="Deep dives on JSON, YAML, XML, and the developer tools built at DevFormats."
  canonical="https://devformats.com/blog"
>
  <div class="mx-auto max-w-[860px] px-4 py-16 text-center">
    <Breadcrumb items={[{ name: 'Blog' }]} />
    <h1 class="mb-3 mt-6 text-2xl font-bold tracking-tight" style="color:var(--fg)">Blog</h1>
    <p class="text-sm" style="color:var(--fg-muted)">Nothing published yet — check back soon.</p>
  </div>
</Layout>
