---
import ToolLayout from '../layouts/ToolLayout.astro';
import YamlToJson from '../components/YamlToJson';
import RelatedTools from '../components/RelatedTools.astro';
import FAQ from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import { getTool, getRelatedTools } from '../data/tools';

const tool = getTool('yaml-to-json')!;
const related = getRelatedTools(tool);

const faqItems = [
  { q: 'What YAML features are supported?', a: 'Anything js-yaml\'s default schema supports: nested maps and sequences, anchors/aliases, multi-line strings, and the standard scalar types (strings, numbers, booleans, null).' },
  { q: 'Why does my YAML fail to convert?', a: 'The most common causes are mixed tabs/spaces, a missing colon after a key, or an unquoted value that YAML interprets as a different type than intended.' },
  { q: 'Can I convert the result back to YAML?', a: 'Yes — use the JSON to YAML tool for the reverse direction.' },
  { q: 'Is my data uploaded anywhere?', a: 'No — the conversion runs entirely in your browser.' },
];
---
<ToolLayout tool={tool}>
  <YamlToJson client:load />

  <AdSlot placement="below-tool" />

  <div class="mx-auto w-full max-w-[860px] space-y-8 px-4 py-10">
    <RelatedTools tools={related} />
    <FAQ items={faqItems} />
  </div>
</ToolLayout>
