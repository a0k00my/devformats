---
// Pure markup — no JS of its own. CommandPaletteModal (rendered once in
// Layout.astro) owns all behavior via event delegation on .df-search-trigger,
// so any number of these can exist on a page (nav + hero) for free.
interface Props {
  variant?: 'nav' | 'hero';
}
const { variant = 'nav' } = Astro.props;
---
{variant === 'hero' ? (
  <button
    class="df-search-trigger flex w-full items-center gap-3 rounded-xl px-5 py-4 text-left text-sm transition-colors sm:text-base"
    style="cursor:pointer;border:1px solid var(--border);background:var(--bg-subtle);color:var(--fg-subtle);box-shadow:var(--shadow-md)"
    aria-label="Search developer tools"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
      <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <span class="flex-1">Search developer tools...</span>
    <kbd class="hidden shrink-0 rounded border px-1.5 py-0.5 font-mono text-[11px] sm:inline" style="border-color:var(--border);color:var(--fg-subtle)">⌘K</kbd>
  </button>
) : (
  <button
    class="df-search-trigger flex h-9 min-w-[160px] items-center gap-2 rounded-lg px-3 text-sm transition-colors sm:min-w-[220px]"
    style="cursor:pointer;border:1px solid var(--border-strong);background:var(--bg);color:var(--fg-muted);box-shadow:var(--shadow-sm)"
    aria-label="Search developer tools"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
      <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
    </svg>
    <span class="hidden flex-1 text-left sm:inline">Search tools…</span>
    <kbd class="hidden shrink-0 rounded border px-1.5 py-0.5 font-mono text-[11px] sm:inline" style="border-color:var(--border);color:var(--fg-subtle)">⌘K</kbd>
  </button>
)}
