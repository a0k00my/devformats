---
import { CATEGORY_META, tools, type Category } from '../data/tools';

const categories = Object.keys(CATEGORY_META) as Category[];
const popularTools = tools.filter(t => t.status === 'live').slice(0, 8);

const resources = [
  { href: '/tools', label: 'All Tools' },
  { href: '/blog', label: 'Blog' },
];
const legal = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy-policy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---
<footer class="border-t" style="border-color:var(--border);background:var(--bg)">
  <div class="mx-auto max-w-[1200px] px-4 py-10">
    <div class="mb-8 flex items-center gap-2">
      <img src="/favicon-96x96.png" alt="DevFormats" class="h-6 w-6 rounded" />
      <span class="text-sm font-semibold" style="color:var(--fg)">DevFormats</span>
    </div>
    <div class="mb-8 max-w-sm rounded-lg border px-3 py-2 text-xs" style="border-color:var(--accent-border);background:var(--accent-bg);color:var(--accent)">
      All processing happens in your browser — nothing is ever uploaded to a server.
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div>
        <div class="mb-3 font-mono text-[10px] uppercase tracking-wider" style="color:var(--fg-subtle)">Categories</div>
        <ul class="space-y-1.5">
          {categories.map(c => (
            <li><a href={`/${c}`} class="text-xs transition-colors" style="color:var(--fg-muted)">{CATEGORY_META[c].name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="mb-3 font-mono text-[10px] uppercase tracking-wider" style="color:var(--fg-subtle)">Popular Tools</div>
        <ul class="space-y-1.5">
          {popularTools.map(t => (
            <li><a href={`/${t.slug}`} class="text-xs transition-colors" style="color:var(--fg-muted)">{t.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="mb-3 font-mono text-[10px] uppercase tracking-wider" style="color:var(--fg-subtle)">Resources</div>
        <ul class="space-y-1.5">
          {resources.map(r => (
            <li><a href={r.href} class="text-xs transition-colors" style="color:var(--fg-muted)">{r.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <div class="mb-3 font-mono text-[10px] uppercase tracking-wider" style="color:var(--fg-subtle)">Legal</div>
        <ul class="space-y-1.5">
          {legal.map(l => (
            <li><a href={l.href} class="text-xs transition-colors" style="color:var(--fg-muted)">{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 border-t pt-4 text-[10px]" style="border-color:var(--border);color:var(--fg-subtle)">
      © {new Date().getFullYear()} devformats.com · All processing is done locally in your browser.
    </div>
  </div>
</footer>
