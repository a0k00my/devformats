---
import ThemeToggle from './ThemeToggle';

const links = [
  { href: '/', label: 'Formatter' },
  { href: '/json-validator', label: 'Validator' },
  { href: '/json-minifier', label: 'Minifier' },
  { href: '/json-to-csv', label: 'JSON→CSV' },
  { href: '/json-diff', label: 'Diff' },
];

const pageLinks = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/privacy-policy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
const pathname = Astro.url.pathname;
---
<nav id="navbar" class="sticky top-0 z-50 border-b" style="background:var(--jfo-bg)/95;backdrop-filter:blur(12px);border-color:var(--jfo-border)">
  <div class="mx-auto flex h-12 max-w-[1600px] items-center gap-3 px-4">

    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2 transition-opacity hover:opacity-80">
      <img src="/favicon-96x96.png" alt="DevFormats" class="h-7 w-7 rounded-md" />
      <span class="text-sm font-semibold tracking-tight" style="color:var(--jfo-text-1)">
        Dev<span style="color:var(--jfo-accent)">Formats</span>
      </span>
    </a>

    <!-- Desktop nav links -->
    <div class="nav-links-hide hidden items-center gap-0.5 overflow-x-auto md:flex" style="scrollbar-width:none">
      {links.map(link => (
        <a
          href={link.href}
          class="shrink-0 rounded px-3 py-1 text-xs font-medium transition-all border"
          style={pathname === link.href
            ? 'background:var(--jfo-accent-bg);color:var(--jfo-accent);border-color:var(--jfo-accent-border)'
            : 'color:var(--jfo-text-3);border-color:transparent;background:transparent;cursor:pointer'}
          onmouseover={pathname !== link.href ? "this.style.background='var(--jfo-bg-soft)';this.style.color='var(--jfo-text-1)';this.style.borderColor='var(--jfo-border)'" : ""}
          onmouseout={pathname !== link.href ? "this.style.background='transparent';this.style.color='var(--jfo-text-3)';this.style.borderColor='transparent'" : ""}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Right controls -->
    <div class="ml-auto flex shrink-0 items-center gap-2">

      <!-- Page links (desktop only) -->
      <div class="hidden items-center md:flex" style="border-left:1px solid var(--jfo-border);margin-left:4px;padding-left:8px;gap:0">
        {pageLinks.map(link => (
          <a
            href={link.href}
            class="rounded px-2.5 py-1 text-[11px] font-medium transition-colors"
            style={pathname === link.href
              ? 'color:var(--jfo-accent)'
              : 'color:var(--jfo-text-3);cursor:pointer'}
            onmouseover={pathname !== link.href ? "this.style.color='var(--jfo-text-1)'" : ""}
            onmouseout={pathname !== link.href ? "this.style.color='var(--jfo-text-3)'" : ""}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="hidden items-center gap-1 sm:flex" style="border-left:1px solid var(--jfo-border);padding-left:8px">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full" style="background:var(--jfo-accent)"></span>
        <span class="font-mono text-[10px]" style="color:var(--jfo-text-3)">CLIENT-SIDE</span>
      </div>
      <ThemeToggle client:load />

      <!-- Hamburger (mobile only) -->
      <button
        id="hamburger"
        class="nav-hamburger hidden h-7 w-7 flex-col items-center justify-center gap-1.5"
        style="cursor:pointer"
        aria-label="Open menu"
      >
        <span class="block h-px w-4 rounded-full transition-all" style="background:var(--jfo-text-2)"></span>
        <span class="block h-px w-4 rounded-full transition-all" style="background:var(--jfo-text-2)"></span>
        <span class="block h-px w-3 rounded-full transition-all" style="background:var(--jfo-text-2)"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div id="mobile-menu" class="hidden border-t px-4 pb-3 pt-2" style="border-color:var(--jfo-border);background:var(--jfo-bg-soft)">
    {links.map(link => (
      <a
        href={link.href}
        class="block rounded px-3 py-2 text-sm font-medium transition-colors"
        style={pathname === link.href
          ? 'color:var(--jfo-accent);background:var(--jfo-accent-bg);cursor:pointer'
          : 'color:var(--jfo-text-2);cursor:pointer'}
      >
        {link.label}
      </a>
    ))}
    <div class="my-2 h-px" style="background:var(--jfo-border)"></div>
    {pageLinks.map(link => (
      <a
        href={link.href}
        class="block rounded px-3 py-2 text-sm font-medium transition-colors"
        style={pathname === link.href
          ? 'color:var(--jfo-accent);background:var(--jfo-accent-bg);cursor:pointer'
          : 'color:var(--jfo-text-2);cursor:pointer'}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  function initNav() {
    // Re-attach hamburger listener every time the DOM is (re)loaded by View Transitions
    const btn = document.getElementById('hamburger');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => menu.classList.toggle('hidden'));
      // Close menu when a link inside it is clicked (navigating away)
      menu.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => menu.classList.add('hidden'));
      });
    }
  }

  // astro:page-load fires on first load AND after every View Transition swap
  document.addEventListener('astro:page-load', initNav);
</script>
