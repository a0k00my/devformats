---
// Vanilla — no React. A toggle button doesn't justify shipping react-dom
// (~57KB gz) on every single page just to flip a class + localStorage key.
---
<button
  id="theme-toggle"
  title="Toggle theme"
  class="flex h-7 w-7 items-center justify-center rounded border transition-all"
  style="cursor:pointer;border-color:var(--border);background:var(--bg-muted);color:var(--fg-subtle)"
  aria-label="Toggle dark/light theme"
>
  <svg id="theme-icon-dark" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <svg id="theme-icon-light" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  function syncIcon() {
    const isDark = document.documentElement.classList.contains('dark');
    document.getElementById('theme-icon-dark')?.classList.toggle('hidden', !isDark);
    document.getElementById('theme-icon-light')?.classList.toggle('hidden', isDark);
  }

  function initThemeToggle() {
    syncIcon();
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      const apply = () => {
        document.documentElement.classList.remove('dark', 'light');
        document.documentElement.classList.add(next);
        localStorage.setItem('jfo-theme', next);
        syncIcon();
        window.dispatchEvent(new Event('jfo-theme-change'));
      };
      // Reuses the same view-transition fade already defined for page
      // navigation, so a theme flip cross-fades instead of hard-snapping.
      if (document.startViewTransition) document.startViewTransition(apply);
      else apply();
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
