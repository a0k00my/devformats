---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import CommandPaletteModal from '../components/CommandPaletteModal.astro';
import ShortcutsOverlay from '../components/ShortcutsOverlay.astro';
import ClientRouter from 'astro/components/ClientRouter.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  ogImage = 'https://devformats.com/og/home.png',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="DevFormats" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f8f8f8" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="DevFormats" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QH5X6RBFXP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QH5X6RBFXP');
      // Re-fire pageview on every View Transition navigation
      document.addEventListener('astro:page-load', () => {
        gtag('event', 'page_view', { page_path: window.location.pathname });
      });
    </script>

    <!-- Apply theme on initial load AND after every View Transition page swap.
         Falls back to prefers-color-scheme when the user hasn't chosen yet —
         inline + is:inline so it runs before paint (no flash of wrong theme). -->
    <script is:inline>
      function applyTheme() {
        var stored = localStorage.getItem('jfo-theme');
        var t = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.remove('dark', 'light');
        document.documentElement.classList.add(t);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ClientRouter />

    <!-- Scroll-reveal: fades/rises .reveal and .reveal-stagger elements into
         view once, re-armed after every View Transition page swap. -->
    <script is:inline>
      function initReveal() {
        var els = document.querySelectorAll('.reveal:not(.is-visible), .reveal-stagger:not(.is-visible)');
        if (!els.length) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });
        els.forEach(function (el) { io.observe(el); });
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </head>
  <body class="flex min-h-screen flex-col" style="background:var(--jfo-bg);color:var(--jfo-text-1)">
    <NavBar />
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer />
    <CommandPaletteModal />
    <ShortcutsOverlay />
  </body>
</html>
